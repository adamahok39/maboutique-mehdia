<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>maboutique.mehdia — Kénitra</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --rose: #f2c3cf;
    --rose-deep: #dd93a8;
    --rose-line: #c97f95;
    --off-white: #f7f2ea;
    --panel: #fffdf9;
    --ink: #1c1a17;
    --concrete: #868075;
    --line: rgba(28,26,23,0.16);
    --radius: 2px;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  *,*::before,*::after{ box-sizing: inherit; }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --rose: #c98098;
      --rose-deep: #e7aabd;
      --rose-line: #c98098;
      --off-white: #1a1815;
      --panel: #221f1b;
      --ink: #f1ece3;
      --concrete: #b3aca0;
      --line: rgba(241,236,227,0.18);
    }
  }
  :root[data-theme="dark"]{
    --rose: #c98098;
    --rose-deep: #e7aabd;
    --rose-line: #c98098;
    --off-white: #1a1815;
    --panel: #221f1b;
    --ink: #f1ece3;
    --concrete: #b3aca0;
    --line: rgba(241,236,227,0.18);
  }
  html{ scroll-padding-top: env(safe-area-inset-top, 0px); scroll-behavior: smooth; }
  html,body{ height: 100%; }
  body{
    margin: 0;
    position: relative;
    background:
      radial-gradient(ellipse 60% 45% at 10% 0%, color-mix(in srgb, var(--rose) 45%, transparent), transparent 60%),
      radial-gradient(ellipse 55% 40% at 95% 30%, color-mix(in srgb, var(--rose) 30%, transparent), transparent 65%),
      radial-gradient(ellipse 65% 50% at 15% 100%, color-mix(in srgb, var(--rose) 32%, transparent), transparent 60%),
      var(--off-white);
    color: var(--ink);
    font-family: "Work Sans", -apple-system, "Segoe UI", sans-serif;
    font-weight: 300;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  body::before{
    content:"";
    position: fixed; inset:0; z-index:0; pointer-events:none;
    background-image: radial-gradient(var(--ink) .55px, transparent .55px);
    background-size: 20px 20px;
    opacity: .05;
  }
  header.nav, main, footer{ position: relative; z-index: 1; }
  img, svg{ max-width: 100%; display:block; }
  a{ color: inherit; }
  .wrap{ max-width: 1180px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 56px); }
  .cross{ position:relative; }
  .cross::before, .cross::after{
    content:""; position:absolute; background: var(--ink); opacity:.55;
  }
  .cross::before{ width:11px; height:1px; top:50%; left:50%; transform:translate(-50%,-50%); }
  .cross::after{ width:1px; height:11px; top:50%; left:50%; transform:translate(-50%,-50%); }
  .ref{
    font-variant: small-caps;
    letter-spacing: .06em;
    font-size: .78rem;
    color: var(--concrete);
  }

  /* ---------- Nav ---------- */
  header.nav{
    position: sticky; top: 0; z-index: 20;
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--off-white) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner{
    display:flex; align-items:center; justify-content:space-between;
    padding: 18px clamp(20px,5vw,56px);
  }
  .brand{
    font-size: 1.05rem; font-weight: 500; letter-spacing: .01em; text-decoration:none;
    display:flex; align-items:baseline; gap: 6px;
  }
  .brand .dot{ color: var(--rose-deep); }
  nav.links{ display:flex; gap: clamp(18px,3vw,40px); font-size: .92rem; }
  nav.links a{ text-decoration:none; position:relative; padding-bottom:2px; }
  nav.links a:hover{ color: var(--rose-deep); }
  .nav-toggle{ display:none; background:none; border:1px solid var(--line); padding:8px 10px; font-size:.85rem; cursor:pointer; color:var(--ink); border-radius:var(--radius); }
  @media (max-width: 720px){
    nav.links{
      position:absolute; top:100%; left:0; right:0;
      flex-direction:column; background:var(--panel);
      border-bottom:1px solid var(--line);
      padding: 18px clamp(20px,5vw,56px) 24px;
      display:none;
      gap: 16px;
    }
    nav.links.open{ display:flex; }
    .nav-toggle{ display:inline-block; }
  }

  /* ---------- Hero ---------- */
  .hero{
    display:grid; grid-template-columns: 1.1fr 1fr;
    border-bottom: 1px solid var(--line);
    min-height: 560px;
  }
  @media (max-width: 860px){ .hero{ grid-template-columns: 1fr; min-height:auto; } }
  .hero-panel{ position:relative; padding: clamp(40px,6vw,72px) clamp(24px,5vw,56px); }
  .hero-panel.rose{
    background: var(--rose);
    color: var(--ink);
    display:flex; flex-direction:column; justify-content:space-between;
    border-right: 1px solid var(--line);
  }
  @media (max-width: 860px){ .hero-panel.rose{ border-right:none; border-bottom:1px solid var(--line);} }
  .hero-mark{
    font-size: clamp(2.6rem, 8vw, 5.2rem);
    font-weight: 300; line-height: .95; letter-spacing: -.01em;
    margin: 0;
  }
  .hero-mark em{ font-style:normal; color: var(--panel); }
  .hero-meta{ display:flex; justify-content:space-between; align-items:flex-end; gap:16px; margin-top: 40px; }
  .hero-meta .ref{ color: var(--ink); opacity:.7; }
  .hero-panel.paper{ background: var(--off-white); display:flex; flex-direction:column; justify-content:center; gap: 26px; }
  .hero-tag{ font-size: clamp(1.1rem, 1.6vw, 1.35rem); font-weight:300; max-width: 30ch; }
  .hero-desc{ color: var(--concrete); max-width: 42ch; font-size: .98rem; }
  .btn{
    display:inline-flex; align-items:center; gap:10px; width:fit-content;
    padding: 13px 26px; border: 1px solid var(--ink); background: transparent;
    color: var(--ink); text-decoration:none; font-size:.92rem; font-weight:500;
    border-radius: var(--radius); cursor:pointer; font-family:inherit;
    transition: background .2s ease, color .2s ease;
  }
  .btn:hover{ background: var(--ink); color: var(--off-white); }
  .btn.solid{ background: var(--ink); color: var(--off-white); border-color: var(--ink); }
  .btn.solid:hover{ background: var(--rose-deep); border-color: var(--rose-deep); color: var(--ink); }

  /* ---------- Liquid glass button ---------- */
  .btn-glass{
    position: relative;
    display: inline-flex; align-items:center; justify-content:center;
    gap: 10px; width: fit-content;
    padding: 15px 32px;
    border-radius: 999px;
    font-family: inherit; font-weight: 500; font-size: .93rem;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    isolation: isolate;
    transition: transform .35s cubic-bezier(.2,.8,.2,1);
  }
  .btn-glass:hover{ transform: scale(1.045); }
  .btn-glass:active{ transform: scale(.98); }
  .btn-glass::before{
    content:""; position:absolute; inset:0; z-index:-2; border-radius: inherit;
    backdrop-filter: blur(6px) url(#glass-distortion);
    -webkit-backdrop-filter: blur(10px);
  }
  .btn-glass::after{
    content:""; position:absolute; inset:0; z-index:-1; border-radius: inherit;
    background: color-mix(in srgb, var(--panel) 45%, transparent);
    border: 1px solid color-mix(in srgb, var(--panel) 70%, transparent);
    box-shadow:
      inset 1px 1px 1px -0.5px rgba(255,255,255,.75),
      inset -1px -1px 1px -0.5px rgba(28,26,23,.18),
      inset 0 0 8px 8px rgba(255,255,255,.12),
      0 6px 18px rgba(28,26,23,.14);
  }
  @media (prefers-reduced-motion: reduce){ .btn-glass{ transition:none; } }
  @media (prefers-reduced-motion: no-preference){
    .hero-mark, .hero-tag, .hero-desc, .hero .btn{
      animation: rise .7s cubic-bezier(.2,.7,.2,1) both;
    }
    .hero-tag{ animation-delay: .08s; }
    .hero-desc{ animation-delay: .16s; }
    .hero .btn{ animation-delay: .24s; }
    @keyframes rise{ from{ opacity:0; transform: translateY(14px);} to{ opacity:1; transform:none; } }
  }

  /* ---------- Section headers ---------- */
  .section-head{
    display:flex; justify-content:space-between; align-items:flex-end;
    gap: 20px; padding: 56px 0 28px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 40px;
  }
  .section-head h2{ font-size: clamp(1.5rem,2.6vw,2.1rem); font-weight:300; margin:0; }
  .section-head .ref{ text-align:right; }

  /* ---------- About ---------- */
  .about{
    display:grid; grid-template-columns: .85fr 1.15fr; gap: 52px; align-items:center;
    padding: 60px 0 68px; border-bottom: 1px solid var(--line);
  }
  @media (max-width: 780px){ .about{ grid-template-columns: 1fr; } }
  .about-visual{
    position:relative; background: var(--rose); min-height: 340px;
    display:flex; align-items:center; justify-content:center; padding: 28px;
  }
  .about-visual svg{ width: 62%; }
  .about-visual .corner{ position:absolute; width:14px; height:14px; }
  .about-visual .corner.tl{ top:10px; left:10px; border-top:1px solid var(--ink); border-left:1px solid var(--ink); opacity:.5; }
  .about-visual .corner.br{ bottom:10px; right:10px; border-bottom:1px solid var(--ink); border-right:1px solid var(--ink); opacity:.5; }
  .about-text .ref{ display:block; margin-bottom: 10px; }
  .about-text h2{ font-size: clamp(1.5rem,2.6vw,2.1rem); font-weight:300; margin: 0 0 18px; }
  .about-text p{ color: var(--concrete); max-width: 54ch; margin: 0 0 14px; font-size: .98rem; }
  .about-text p.lead{ color: var(--ink); font-size: 1.05rem; }
  .about-sign{ margin-top: 18px; font-variant: small-caps; letter-spacing: .05em; font-size: .88rem; color: var(--ink); }

  /* ---------- Collection grid ---------- */
  .grid4{
    display:grid; grid-template-columns: repeat(4,1fr); gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-bottom: 72px;
  }
  @media (max-width: 900px){ .grid4{ grid-template-columns: repeat(2,1fr);} }
  @media (max-width: 480px){ .grid4{ grid-template-columns: 1fr;} }
  .card{
    background: var(--panel); padding: 22px 22px 24px;
    display:flex; flex-direction:column; gap: 14px;
    transition: transform .2s ease;
    cursor: pointer;
  }
  .card:hover{ transform: translateY(-3px); }
  .card:focus-visible{ outline: 2px solid var(--rose-deep); outline-offset: -2px; }
  .card-top{ display:flex; justify-content:space-between; align-items:flex-start; }
  .shot{
    position:relative; height: 210px; display:flex; align-items:flex-end; justify-content:center;
    overflow:hidden; border: 1px solid var(--line);
  }
  .shot svg{ width: 68%; height: 92%; position:relative; z-index:1; }
  .shot::after{
    content:""; position:absolute; inset:0;
    background: radial-gradient(ellipse 90% 60% at 50% 100%, rgba(0,0,0,.14), transparent 70%);
  }
  .shot-1{ background: linear-gradient(160deg, #f6dde3, #f2c3cf 70%); }
  .shot-2{ background: linear-gradient(160deg, var(--off-white), #ecd9de 80%); }
  .shot-3{ background: linear-gradient(160deg, #efe6d8, #e7cdd6 85%); }
  .shot-4{ background: linear-gradient(160deg, #ddc7ce, #c9a3b0 85%); }
  .card h3{ font-size: 1.02rem; font-weight:500; margin: 4px 0 0; }
  .card p.spec{ color: var(--concrete); font-size: .86rem; margin:0; }
  .card .price{ margin-top:auto; padding-top:10px; font-size:.95rem; display:flex; justify-content:space-between; border-top:1px solid var(--line); }

  /* ---------- Avis clients ---------- */
  .avis{ padding: 12px 0 70px; }
  .avis-grid{
    display:grid; grid-template-columns: repeat(3,1fr); gap: 1px;
    background: var(--line); border: 1px solid var(--line);
  }
  @media (max-width: 860px){ .avis-grid{ grid-template-columns: 1fr; } }
  .avis-card{ background: var(--panel); padding: 26px 24px; display:flex; flex-direction:column; gap: 16px; }
  .avis-marks{ display:flex; gap: 5px; }
  .avis-marks span{
    width:8px; height:8px; background: var(--ink); opacity:.15;
    transform: rotate(45deg);
  }
  .avis-marks span.on{ opacity: .85; background: var(--rose-deep); }
  .avis-quote{ font-size: .98rem; margin: 0; color: var(--ink); }
  .avis-who{ display:flex; align-items:center; gap: 12px; margin-top:auto; padding-top: 14px; border-top: 1px solid var(--line); }
  .avis-avatar{
    width: 36px; height: 36px; flex: none; background: var(--rose);
    display:flex; align-items:center; justify-content:center;
    font-size: .78rem; font-weight: 500;
  }
  .avis-name{ font-size: .88rem; line-height:1.3; }
  .avis-name .loc{ display:block; color: var(--concrete); font-size: .78rem; }

  /* ---------- Product modal ---------- */
  .modal-overlay{
    position: fixed; inset: 0; z-index: 100;
    background: rgba(20,18,16,.55);
    display: flex; align-items:center; justify-content:center;
    padding: 20px;
    padding-top: calc(20px + env(safe-area-inset-top,0px));
    padding-bottom: calc(20px + env(safe-area-inset-bottom,0px));
    opacity: 0; pointer-events: none;
    transition: opacity .2s ease;
  }
  .modal-overlay.open{ opacity: 1; pointer-events: auto; }
  .modal-panel{
    position: relative; width: min(760px, 100%);
    max-height: 88vh; overflow-y: auto;
    background: var(--panel); border: 1px solid var(--line);
    display: grid; grid-template-columns: .9fr 1.1fr;
    transform: translateY(10px); transition: transform .25s cubic-bezier(.2,.8,.2,1);
  }
  .modal-overlay.open .modal-panel{ transform: translateY(0); }
  @media (max-width: 660px){ .modal-panel{ grid-template-columns: 1fr; } }
  .modal-close{
    position: absolute; top: 14px; right: 14px; z-index: 2;
    width: 30px; height: 30px; border: 1px solid var(--line); background: var(--panel);
    color: var(--ink); font-size: 1rem; line-height: 1; cursor: pointer; border-radius: var(--radius);
  }
  .modal-close:hover{ background: var(--rose); }
  .modal-shot{ min-height: 260px; display:flex; align-items:flex-end; justify-content:center; padding: 30px; position:relative; }
  .modal-shot svg{ width: 62%; position:relative; z-index:1; }
  .modal-shot::after{ content:""; position:absolute; inset:0; background: radial-gradient(ellipse 90% 60% at 50% 100%, rgba(0,0,0,.14), transparent 70%); }
  .modal-shot.shot-1{ background: linear-gradient(160deg, #f6dde3, #f2c3cf 70%); }
  .modal-shot.shot-2{ background: linear-gradient(160deg, var(--off-white), #ecd9de 80%); }
  .modal-shot.shot-3{ background: linear-gradient(160deg, #efe6d8, #e7cdd6 85%); }
  .modal-shot.shot-4{ background: linear-gradient(160deg, #ddc7ce, #c9a3b0 85%); }
  .modal-body{ padding: 34px 32px; display:flex; flex-direction:column; gap: 18px; }
  .modal-body .ref{ display:block; }
  .modal-body h3{ margin: 2px 0 0; font-size: 1.3rem; font-weight: 400; }
  .modal-body .modal-spec{ color: var(--concrete); font-size: .92rem; margin: -6px 0 0; }
  .modal-body .modal-price{ font-size: 1.05rem; }
  .modal-field label{ font-variant: small-caps; letter-spacing: .05em; font-size: .8rem; color: var(--concrete); display:block; margin-bottom: 10px; }
  .swatches{ display:flex; gap: 10px; align-items:center; }
  .swatch{
    width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--line);
    cursor: pointer; position: relative; padding:0;
  }
  .swatch.active{ outline: 2px solid var(--ink); outline-offset: 2px; }
  .modal-selected-color{ font-size: .85rem; color: var(--concrete); margin-left: 4px; }
  .sizes{ display:flex; gap: 8px; }
  .size-btn{
    min-width: 42px; padding: 9px 6px; border: 1px solid var(--line); background: var(--panel);
    font-family: inherit; font-size: .88rem; cursor: pointer; border-radius: var(--radius); color: var(--ink);
  }
  .size-btn.active{ background: var(--ink); color: var(--off-white); border-color: var(--ink); }
  .modal-confirm{
    margin-top: 4px; padding: 14px 26px; background: var(--ink); color: var(--off-white);
    border: none; font-family: inherit; font-weight: 500; font-size: .93rem; cursor: pointer;
    border-radius: var(--radius); width: fit-content;
  }
  .modal-confirm:hover{ background: var(--rose-deep); color: var(--ink); }
  .modal-note{ font-size: .84rem; color: var(--concrete); min-height: 1.2em; }
  .modal-note.ok{ color: var(--rose-deep); }

  /* ---------- Newsletter ---------- */
  .newsletter{
    background: var(--rose);
    color: var(--ink);
    padding: 64px clamp(24px,5vw,56px);
    display:grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items:center;
    border-top:1px solid var(--line); border-bottom:1px solid var(--line);
  }
  @media (max-width: 780px){ .newsletter{ grid-template-columns:1fr; } }
  .newsletter h2{ font-size: clamp(1.5rem,3vw,2.1rem); font-weight:300; margin:0 0 10px; }
  .newsletter p{ margin:0; max-width: 40ch; color: color-mix(in srgb, var(--ink) 78%, transparent); }
  form.sub{ display:flex; gap: 0; border-bottom: 1.5px solid var(--ink); padding-bottom: 10px; }
  form.sub input{
    flex:1; background:none; border:none; outline:none; font-family:inherit;
    font-size: 1rem; color: var(--ink); font-weight:300; padding: 6px 4px;
  }
  form.sub input::placeholder{ color: color-mix(in srgb, var(--ink) 55%, transparent); }
  form.sub button{
    background:none; border:none; font-family:inherit; font-weight:500; font-size:.95rem;
    color: var(--ink); cursor:pointer; padding: 6px 4px; white-space:nowrap;
  }
  form.sub button:hover{ color: var(--panel); }
  .sub-note{ font-size:.8rem; margin-top:10px; color: color-mix(in srgb, var(--ink) 60%, transparent); }

  /* ---------- Contact ---------- */
  .contact{ padding: 64px 0 30px; display:grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  @media (max-width: 780px){ .contact{ grid-template-columns:1fr; } }
  .contact h2{ font-size: clamp(1.5rem,2.6vw,2rem); font-weight:300; margin: 0 0 22px; }
  dl.info{ margin:0; display:grid; gap: 18px; }
  dl.info div{ padding-bottom:14px; border-bottom: 1px solid var(--line); }
  dl.info dt{ font-variant: small-caps; letter-spacing:.05em; font-size:.78rem; color: var(--concrete); margin-bottom:4px; }
  dl.info dd{ margin:0; font-size: 1rem; }
  dl.info a{ text-decoration:none; border-bottom:1px solid var(--rose-line); }
  dl.info a:hover{ color: var(--rose-deep); }
  .map-block{
    border: 1px solid var(--line); background: var(--panel); padding: 24px;
    display:flex; flex-direction:column; gap:18px; position:relative;
  }
  .map-block .corner{ position:absolute; width:14px; height:14px; }
  .map-block .corner.tl{ top:8px; left:8px; border-top:1px solid var(--ink); border-left:1px solid var(--ink); opacity:.5;}
  .map-block .corner.br{ bottom:8px; right:8px; border-bottom:1px solid var(--ink); border-right:1px solid var(--ink); opacity:.5;}
  .map-illustration{ width:100%; height:190px; }
  .map-address{ font-size:.95rem; }
  .map-address .ref{ display:block; margin-bottom:6px; }
  .map-link{ font-size:.88rem; text-decoration:none; border-bottom:1px solid var(--rose-line); width:fit-content; }
  .map-link:hover{ color: var(--rose-deep); }

  /* ---------- Footer ---------- */
  footer{
    padding: 30px clamp(20px,5vw,56px) calc(30px + env(safe-area-inset-bottom,0px));
    border-top:1px solid var(--line);
    display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;
    font-size:.82rem; color: var(--concrete);
  }
  footer .brand{ font-size:.9rem; color: var(--ink); }
</style>
</head>
<body>
<svg style="position:absolute; width:0; height:0; overflow:hidden" aria-hidden="true">
  <defs>
    <filter id="glass-distortion" x="0%" y="0%" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.008 0.008" numOctaves="2" seed="7" result="turbulence"/>
      <feGaussianBlur in="turbulence" stdDeviation="2" result="blurredNoise"/>
      <feDisplacementMap in="SourceGraphic" in2="blurredNoise" scale="46" xChannelSelector="R" yChannelSelector="B" result="displaced"/>
      <feGaussianBlur in="displaced" stdDeviation="3" result="finalBlur"/>
      <feComposite in="finalBlur" in2="finalBlur" operator="over"/>
    </filter>
  </defs>
</svg>

<header class="nav">
  <div class="nav-inner">
    <a href="#top" class="brand">maboutique<span class="dot">.</span>mehdia</a>
    <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navLinks">Menu</button>
    <nav class="links" id="navLinks">
      <a href="#apropos">À propos</a>
      <a href="#collection">Collection</a>
      <a href="#avis">Avis</a>
      <a href="#contact">Contact</a>
    </nav>
  </div>
</header>

<main id="top">

  <section class="hero">
    <div class="hero-panel rose">
      <p class="hero-mark">La coupe<br>comme <em>structure.</em></p>
      <div class="hero-meta">
        <span class="ref">Kénitra — Maroc</span>
        <span class="ref">Réf. collection 09</span>
      </div>
    </div>
    <div class="hero-panel paper">
      <p class="hero-tag">Des pièces pensées avec précision, portées avec intention.</p>
      <p class="hero-desc">maboutique.mehdia assemble des lignes nettes et des matières simples pour la femme qui choisit chaque vêtement comme on choisit un outil : pour ce qu'il fait, pas seulement pour son allure.</p>
