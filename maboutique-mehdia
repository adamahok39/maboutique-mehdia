<script>
  document.getElementById('navToggle')?.addEventListener('click', function(){
    var links = document.getElementById('navLinks');
    var open = links.classList.toggle('open');
    this.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.getElementById('subForm')?.addEventListener('submit', function(e){
    e.preventDefault();
    document.getElementById('subNote').textContent = 'Merci, votre inscription est enregistrée pour cette démonstration.';
    this.reset();
  });

  (function(){
    var modal = document.getElementById('productModal');
    var modalShot = document.getElementById('modalShot');
    var modalRef = document.getElementById('modalRef');
    var modalTitle = document.getElementById('modalTitle');
    var modalSpec = document.getElementById('modalSpec');
    var modalPrice = document.getElementById('modalPrice');
    var modalColors = document.getElementById('modalColors');
    var modalSelectedColor = document.getElementById('modalSelectedColor');
    var modalSizes = document.getElementById('modalSizes');
    var modalConfirm = document.getElementById('modalConfirm');
    var modalNote = document.getElementById('modalNote');
    var modalClose = document.getElementById('modalClose');
    var lastFocused = null;
    var selectedColor = '';
    var selectedSize = 'M';

    function openModal(card){
      lastFocused = document.activeElement;
      var name = card.dataset.name;
      var ref = card.dataset.ref;
      var spec = card.dataset.spec;
      var price = card.dataset.price;
      var colors = card.dataset.colors.split(',').map(function(c){
        var parts = c.split(':'); return { name: parts[0], hex: parts[1] };
      });
      var shotEl = card.querySelector('.shot');
      var shotClass = '';
      if (shotEl){
        shotEl.classList.forEach(function(c){ if (c.indexOf('shot-') === 0) shotClass = c; });
      }
      modalShot.className = 'modal-shot ' + shotClass;
      modalShot.innerHTML = shotEl ? shotEl.querySelector('svg').outerHTML : '';
      modalRef.textContent = ref;
      modalTitle.textContent = name;
      modalSpec.textContent = spec;
      modalPrice.textContent = price;

      modalColors.innerHTML = '';
      colors.forEach(function(c, i){
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'swatch' + (i === 0 ? ' active' : '');
        btn.style.background = c.hex;
        btn.title = c.name;
        btn.setAttribute('aria-label', c.name);
        btn.addEventListener('click', function(){
          modalColors.querySelectorAll('.swatch').forEach(function(s){ s.classList.remove('active'); });
          btn.classList.add('active');
          selectedColor = c.name;
          modalSelectedColor.textContent = c.name;
        });
        modalColors.appendChild(btn);
      });
      selectedColor = colors[0].name;
      modalSelectedColor.textContent = selectedColor;

      modalSizes.querySelectorAll('.size-btn').forEach(function(b){
        b.classList.toggle('active', b.dataset.size === 'M');
      });
      selectedSize = 'M';

      modalNote.textContent = '';
      modalNote.classList.remove('ok');
      modalConfirm.textContent = 'Ajouter au panier';

      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
      modalClose.focus();
    }

    function closeModal(){
      modal.classList.remove('open');
      document.body.style.overflow = '';
      if (lastFocused) lastFocused.focus();
    }

    document.querySelectorAll('.card').forEach(function(card){
      card.addEventListener('click', function(){ openModal(card); });
      card.addEventListener('keydown', function(e){
        if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); openModal(card); }
      });
    });

    modalSizes.querySelectorAll('.size-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        modalSizes.querySelectorAll('.size-btn').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        selectedSize = btn.dataset.size;
      });
    });

    modalConfirm.addEventListener('click', function(){
      modalNote.textContent = 'Ajouté — ' + modalTitle.textContent + ', taille ' + selectedSize + ', coloris ' + selectedColor + '.';
      modalNote.classList.add('ok');
    });

    modalClose.addEventListener('click', closeModal);
    modal.addEventListener('click', function(e){ if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    });
  })();
</script>

