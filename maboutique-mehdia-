    <path d="M16 4C9.4 4 4 9 4 15.2c0 2.4.8 4.6 2.2 6.4L5 28l6.6-2c1.4.6 3 .9 4.4.9 6.6 0 12-5 12-11.2S22.6 4 16 4Z" fill="#fff"/>
    <path d="M12 12.3c.2-.5.5-.5.8-.5h.6c.2 0 .5 0 .7.5.3.6.9 2 1 2.1.1.2.1.4 0 .6-.1.2-.2.3-.4.5-.2.2-.4.4-.2.7.6 1 1.4 1.8 2.4 2.3.3.2.5.1.7-.1.2-.2.7-.8.9-1 .2-.2.4-.2.6-.1.3.1 1.7.8 2 1 .2.1.4.2.5.3.1.2.1.9-.2 1.4-.3.6-1.5 1.2-2.1 1.2-.6 0-1.3 0-2.9-.7-2.4-1-4-3.3-4.1-3.4-.1-.2-1-1.3-1-2.5 0-1.2.6-1.8.8-2.1Z" fill="#25D366"/>
  </svg>
</a>

<footer>
  <span class="brand">maboutique.mehdia</span>
  <span>Kénitra, Maroc — © 2026</span>
</footer>

<script>
  document.getElementById('navToggle')?.addEventListener('click', function(){
    var links = document.getElementById('navLinks');
    var open = links.classList.toggle('open');
    this.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  document.getElementById('subForm')?.addEventListener('submit', function(e){
    e.preventDefault();
    document.getElementById('subNote').textContent = 'Merci, votre inscription est enregistrée pour cette démonstration.';
    this.reset();
  });

  (function(){
    var modal = document.getElementById('productModal');
    var modalShot = document.getElementById('modalShot');
    var modalRef = document.getElementById('modalRef');
    var modalTitle = document.getElementById('modalTitle');
    var modalSpec = document.getElementById('modalSpec');
    var modalPrice = document.getElementById('modalPrice');
    var modalColors = document.getElementById('modalColors');
    var modalSelectedColor = document.getElementById('modalSelectedColor');
    var modalSizes = document.getElementById('modalSizes');
    var modalConfirm = document.getElementById('modalConfirm');
    var modalNote = document.getElementById('modalNote');
    var modalClose = document.getElementById('modalClose');
    var lastFocused = null;
    var selectedColor = '';
    var selectedColorHex = '';
    var selectedSize = 'M';

    function openModal(card){
      lastFocused = document.activeElement;
      var name = card.dataset.name;
      var ref = card.dataset.ref;
      var spec = card.dataset.spec;
      var price = card.dataset.price;
      var colors = card.dataset.colors.split(',').map(function(c){
        var parts = c.split(':'); return { name: parts[0], hex: parts[1] };
      });
      var shotEl = card.querySelector('.shot');
      var shotClass = '';
      if (shotEl){
        shotEl.classList.forEach(function(c){ if (c.indexOf('shot-') === 0) shotClass = c; });
      }
      modalShot.className = 'modal-shot ' + shotClass;
      modalShot.innerHTML = shotEl ? shotEl.querySelector('svg').outerHTML : '';
      modalRef.textContent = ref;
      modalTitle.textContent = name;
      modalSpec.textContent = spec;
      modalPrice.textContent = price;

      modalColors.innerHTML = '';
      colors.forEach(function(c, i){
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'swatch' + (i === 0 ? ' active' : '');
        btn.style.background = c.hex;
        btn.title = c.name;
        btn.setAttribute('aria-label', c.name);
        btn.addEventListener('click', function(){
          modalColors.querySelectorAll('.swatch').forEach(function(s){ s.classList.remove('active'); });
          btn.classList.add('active');
          selectedColor = c.name;
          selectedColorHex = c.hex;
          modalSelectedColor.textContent = c.name;
        });
        modalColors.appendChild(btn);
      });
      selectedColor = colors[0].name;
      selectedColorHex = colors[0].hex;
      modalSelectedColor.textContent = selectedColor;

      modalSizes.querySelectorAll('.size-btn').forEach(function(b){
        b.classList.toggle('active', b.dataset.size === 'M');
      });
      selectedSize = 'M';

      modalNote.textContent = '';
      modalNote.classList.remove('ok');
      modalConfirm.textContent = 'Ajouter au panier';

      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
      modalClose.focus();
    }

    function closeModal(){
      modal.classList.remove('open');
      document.body.style.overflow = '';
      if (lastFocused) lastFocused.focus();
    }

    document.querySelectorAll('.card').forEach(function(card){
      card.addEventListener('click', function(){ openModal(card); });
      card.addEventListener('keydown', function(e){
        if (e.key === 'Enter' || e.key === ' '){ e.preventDefault(); openModal(card); }
      });
    });

    modalSizes.querySelectorAll('.size-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        modalSizes.querySelectorAll('.size-btn').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        selectedSize = btn.dataset.size;
      });
    });

    modalConfirm.addEventListener('click', function(){
      var priceNum = parseFloat((modalPrice.textContent || '0').replace(/[^\d.]/g, '')) || 0;
      if (window.addToCart){
        window.addToCart({
          name: modalTitle.textContent,
          size: selectedSize,
          color: selectedColor,
          colorHex: selectedColorHex,
          price: priceNum
        });
      }
      modalNote.textContent = 'Ajouté au panier — ' + modalTitle.textContent + ', taille ' + selectedSize + ', coloris ' + selectedColor + '.';
      modalNote.classList.add('ok');
    });

    modalClose.addEventListener('click', closeModal);
    modal.addEventListener('click', function(e){ if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    });
  })();

  /* ==== Configuration — à modifier par la boutique ==== */
  var SITE_CONFIG = {
    // Numéro WhatsApp complet, sans "+", ex: 212612345678
    whatsappPhone: '212655537670',
    // Identifiant du formulaire Formspree (https://formspree.io)
    formspreeId: 'mppwpqjl'
  };

  (function(){
    var waFloat = document.getElementById('waFloat');
    if (waFloat){
      var waMsg = encodeURIComponent("Bonjour maboutique.mehdia, j'aimerais avoir des informations.");
      waFloat.href = 'https://wa.me/' + SITE_CONFIG.whatsappPhone + '?text=' + waMsg;
    }
  })();

  (function(){
    var CART_KEY = 'mabom_cart_v1';
    var cartBtn = document.getElementById('cartBtn');
    var cartBadge = document.getElementById('cartBadge');
    var cartOverlay = document.getElementById('cartOverlay');
    var cartClose = document.getElementById('cartClose');
    var cartItemsEl = document.getElementById('cartItems');
    var cartTotalEl = document.getElementById('cartTotal');
    var cartCheckoutBtn = document.getElementById('cartCheckoutBtn');

    var checkoutModal = document.getElementById('checkoutModal');
    var checkoutClose = document.getElementById('checkoutClose');
    var checkoutSummary = document.getElementById('checkoutSummary');
    var checkoutForm = document.getElementById('checkoutForm');
    var checkoutNote = document.getElementById('checkoutNote');

    function loadCart(){
      try { return JSON.parse(localStorage.getItem(CART_KEY)) || []; }
      catch(e){ return []; }
    }
    function saveCart(){
      try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch(e){}
    }

    var cart = loadCart();

    function updateBadge(){
      var count = cart.reduce(function(s,i){ return s + i.qty; }, 0);
      if (!cartBadge) return;
      if (count > 0){ cartBadge.hidden = false; cartBadge.textContent = count; }
      else { cartBadge.hidden = true; }
    }

    function renderCart(){
      if (!cartItemsEl) return;
      cartItemsEl.innerHTML = '';
      if (cart.length === 0){
        var empty = document.createElement('p');
        empty.className = 'cart-empty';
        empty.textContent = 'Votre panier est vide.';
        cartItemsEl.appendChild(empty);
      } else {
        cart.forEach(function(item, idx){
          var row = document.createElement('div');
          row.className = 'cart-item';
          row.innerHTML =
            '<span class="swatch-dot" style="background:' + (item.colorHex || '#ccc') + '"></span>' +
            '<div class="cart-item-info"><strong>' + item.name + '</strong><span>' + item.color + ' · ' + item.size + ' · ' + item.price + ' MAD</span></div>' +
            '<div class="cart-item-actions">' +
              '<div class="qty-stepper">' +
                '<button type="button" data-action="dec" data-idx="' + idx + '" aria-label="Diminuer">−</button>' +
                '<span>' + item.qty + '</span>' +
                '<button type="button" data-action="inc" data-idx="' + idx + '" aria-label="Augmenter">+</button>' +
              '</div>' +
              '<button type="button" class="cart-item-remove" data-action="remove" data-idx="' + idx + '">Retirer</button>' +
            '</div>';
          cartItemsEl.appendChild(row);
        });
      }
      var total = cart.reduce(function(s,i){ return s + i.price * i.qty; }, 0);
      if (cartTotalEl) cartTotalEl.textContent = total + ' MAD';
      if (cartCheckoutBtn) cartCheckoutBtn.disabled = cart.length === 0;
      updateBadge();
    }

    window.addToCart = function(item){
      var existing = null;
      for (var i = 0; i < cart.length; i++){
        if (cart[i].name === item.name && cart[i].color === item.color && cart[i].size === item.size){ existing = cart[i]; break; }
      }
      if (existing){ existing.qty += 1; }
      else { cart.push({ name: item.name, color: item.color, colorHex: item.colorHex, size: item.size, price: item.price, qty: 1 }); }
      saveCart();
      renderCart();
    };

    if (cartItemsEl){
      cartItemsEl.addEventListener('click', function(e){
        var btn = e.target.closest('button[data-action]');
        if (!btn) return;
        var idx = parseInt(btn.dataset.idx, 10);
        var action = btn.dataset.action;
        if (action === 'inc') cart[idx].qty += 1;
        if (action === 'dec'){ cart[idx].qty -= 1; if (cart[idx].qty <= 0) cart.splice(idx,1); }
        if (action === 'remove') cart.splice(idx,1);
        saveCart();
        renderCart();
      });
    }

    function openCart(){
      renderCart();
      cartOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeCart(){
      cartOverlay.classList.remove('open');
      document.body.style.overflow = '';
    }
    if (cartBtn) cartBtn.addEventListener('click', openCart);
    if (cartClose) cartClose.addEventListener('click', closeCart);
    if (cartOverlay) cartOverlay.addEventListener('click', function(e){ if (e.target === cartOverlay) closeCart(); });

    function openCheckout(){
      closeCart();
      var lines = cart.map(function(i){
        return i.name + ' — ' + i.color + ', taille ' + i.size + ' × ' + i.qty + ' — ' + (i.price * i.qty) + ' MAD';
      });
      var total = cart.reduce(function(s,i){ return s + i.price * i.qty; }, 0);
      checkoutSummary.innerHTML = lines.join('<br>') + '<br><br><strong>Total : ' + total + ' MAD</strong>';
      checkoutNote.textContent = '';
      checkoutNote.classList.remove('ok');
      checkoutModal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeCheckout(){
      checkoutModal.classList.remove('open');
      document.body.style.overflow = '';
    }
    if (cartCheckoutBtn) cartCheckoutBtn.addEventListener('click', openCheckout);
    if (checkoutClose) checkoutClose.addEventListener('click', closeCheckout);
    if (checkoutModal) checkoutModal.addEventListener('click', function(e){ if (e.target === checkoutModal) closeCheckout(); });
    document.addEventListener('keydown', function(e){
      if (e.key !== 'Escape') return;
      if (checkoutModal.classList.contains('open')) closeCheckout();
      else if (cartOverlay.classList.contains('open')) closeCart();
    });

    if (checkoutForm){
      checkoutForm.addEventListener('submit', function(e){
        e.preventDefault();
        var name = document.getElementById('ckName').value.trim();
        var phone = document.getElementById('ckPhone').value.trim();
        var address = document.getElementById('ckAddress').value.trim();
        var paymentInput = checkoutForm.querySelector('input[name="payment"]:checked');
        var payment = paymentInput ? paymentInput.value : 'Paiement à la livraison';

        var itemLines = cart.map(function(i){
          return '- ' + i.name + ' (' + i.color + ', ' + i.size + ') x' + i.qty + ' — ' + (i.price * i.qty) + ' MAD';
        }).join('\n');
        var total = cart.reduce(function(s,i){ return s + i.price * i.qty; }, 0);

        var msgText = 'Nouvelle commande maboutique.mehdia\n' +
          'Client : ' + name + '\n' +
          'Téléphone : ' + phone + '\n' +
          'Adresse : ' + address + '\n' +
          'Paiement : ' + payment + '\n\n' +
          'Articles :\n' + itemLines + '\n\n' +
          'Total : ' + total + ' MAD';

        window.open('https://wa.me/' + SITE_CONFIG.whatsappPhone + '?text=' + encodeURIComponent(msgText), '_blank');

        if (SITE_CONFIG.formspreeId && SITE_CONFIG.formspreeId !== 'YOUR_FORM_ID'){
          var fd = new FormData(checkoutForm);
          fd.append('_subject', 'Nouvelle commande — maboutique.mehdia');
          fd.append('order_summary', itemLines + '\nTotal : ' + total + ' MAD');
          fetch('https://formspree.io/f/' + SITE_CONFIG.formspreeId, {
            method: 'POST',
            headers: { 'Accept': 'application/json' },
            body: fd
          }).catch(function(){});
        }

        checkoutNote.textContent = 'Commande envoyée via WhatsApp. Merci ' + name + ' !';
        checkoutNote.classList.add('ok');
        cart = [];
        saveCart();
        renderCart();
        checkoutForm.reset();
        setTimeout(closeCheckout, 1800);
      });
    }

    renderCart();
  })();

  (function(){
    var contactForm = document.getElementById('contactForm');
    var contactNote = document.getElementById('contactNote');
    if (!contactForm) return;
    contactForm.addEventListener('submit', function(e){
      e.preventDefault();
      if (!SITE_CONFIG.formspreeId || SITE_CONFIG.formspreeId === 'YOUR_FORM_ID'){
        contactNote.textContent = "Formulaire pas encore configuré — contactez-nous par téléphone ou WhatsApp en attendant.";
        return;
      }
      var submitBtn = contactForm.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      contactNote.textContent = 'Envoi en cours…';
      contactNote.classList.remove('ok');

      fetch('https://formspree.io/f/' + SITE_CONFIG.formspreeId, {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(contactForm)
      }).then(function(res){
        if (res.ok){
          contactNote.textContent = 'Message envoyé, merci ! Nous revenons vers vous rapidement.';
          contactNote.classList.add('ok');
          contactForm.reset();
        } else {
          contactNote.textContent = 'Une erreur est survenue — réessayez ou contactez-nous par WhatsApp.';
        }
      }).catch(function(){
        contactNote.textContent = 'Connexion impossible — réessayez ou contactez-nous par WhatsApp.';
      }).finally(function(){
        if (submitBtn) submitBtn.disabled = false;
      });
    });
  })();
</script>

</body>
</html>
